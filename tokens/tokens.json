{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "name": "Jobpin / 职聘 — Design Tokens",
    "version": "0.1.0",
    "owner": "JR Academy",
    "tagline": "你的 AI 求职助手 — 帮你分析 JD、优化简历、准备面试、追踪投递进度",
    "mood": "Warm Professional Blue — LinkedIn × Canva × Linear",
    "mascot": "bull (same family as UniMate AI) — with sunglasses + suit + briefcase",
    "grid": "4pt",
    "primaryFont": "PingFang SC / 思源黑体",
    "source": "job_hunter_design_system.md (2026-05-11)",
    "siblings": ["unimate-ai", "cert-master"]
  },
  "color": {
    "brand": {
      "primary":   { "$value": "#5F7CFB", "$type": "color", "$description": "Periwinkle 主色 — CTA · AI 分析" },
      "secondary": { "$value": "#9BB1FF", "$type": "color", "$description": "次级蓝 — 柔和高亮 / 图标 bg" },
      "accent":    { "$value": "#FF8A7A", "$type": "color", "$description": "珊瑚强调 — Offer · 转化 CTA" },
      "navy":      { "$value": "#182035", "$type": "color", "$description": "海军深 — 标题 / Logo 文字" }
    },
    "neutral": {
      "gray":      { "$value": "#66728D", "$type": "color", "$description": "中性灰 — 正文 / 辅助" },
      "lightGray": { "$value": "#E6E9F2", "$type": "color", "$description": "浅灰 — border / divider" },
      "warmWhite": { "$value": "#FFFEF7", "$type": "color", "$description": "暖白 — 页面默认 bg（不要纯白）" },
      "white":     { "$value": "#FFFFFF", "$type": "color", "$description": "白色 — 卡片表面" }
    },
    "functional": {
      "success": { "$value": "#35C98B", "$type": "color", "$description": "高匹配 / 已投 / 完成" },
      "warning": { "$value": "#FFB84D", "$type": "color", "$description": "待优化 / 注意" },
      "error":   { "$value": "#FF6B6B", "$type": "color", "$description": "缺失技能 / 风险" },
      "insight": { "$value": "#8B5CF6", "$type": "color", "$description": "AI insight / 智能建议" }
    },
    "soft": {
      "blue":   { "$value": "#EEF3FF", "$type": "color", "$description": "信息卡 / AI 分析背景" },
      "green":  { "$value": "#EAFBF3", "$type": "color", "$description": "高匹配背景" },
      "amber":  { "$value": "#FFF6E0", "$type": "color", "$description": "警告 / 薪资提示" },
      "purple": { "$value": "#F2EDFF", "$type": "color", "$description": "AI 建议背景" },
      "peach":  { "$value": "#FFF0E8", "$type": "color", "$description": "温暖提示 / banner bg" }
    },
    "gradient": {
      "primary": { "$value": "linear-gradient(135deg, #6F8CFF 0%, #4F6EF7 100%)", "$type": "gradient", "$description": "AI 分析 / 主按钮 / Active bottom nav" },
      "softBlue":{ "$value": "linear-gradient(135deg, #F3F6FF 0%, #EAF0FF 100%)", "$type": "gradient", "$description": "Hero card / AI assistant card" },
      "coral":   { "$value": "linear-gradient(135deg, #FF9A80 0%, #FF6B5F 100%)", "$type": "gradient", "$description": "Offer / 高紧迫 CTA / banner" },
      "success": { "$value": "linear-gradient(135deg, #6BE7BF 0%, #1FC692 100%)", "$type": "gradient", "$description": "高匹配 / 已完成" }
    }
  },
  "radius": {
    "xs":   { "$value": "6px",  "$type": "dimension", "$description": "Icon micro" },
    "sm":   { "$value": "10px", "$type": "dimension", "$description": "Tags" },
    "md":   { "$value": "14px", "$type": "dimension", "$description": "Inputs" },
    "lg":   { "$value": "18px", "$type": "dimension", "$description": "Small cards" },
    "xl":   { "$value": "22px", "$type": "dimension", "$description": "Standard cards" },
    "xxl":  { "$value": "28px", "$type": "dimension", "$description": "Feature cards / Modal" },
    "xxxl": { "$value": "36px", "$type": "dimension", "$description": "Hero / promo banners" },
    "full": { "$value": "9999px","$type": "dimension", "$description": "Buttons / pills" }
  },
  "spacing": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" }
  },
  "shadow": {
    "xs":         { "$value": "0 2px 8px rgba(24,32,53,0.04)",  "$type": "shadow", "$description": "小按钮" },
    "sm":         { "$value": "0 4px 12px rgba(24,32,53,0.06)", "$type": "shadow", "$description": "输入框" },
    "md":         { "$value": "0 8px 24px rgba(24,32,53,0.08)", "$type": "shadow", "$description": "卡片默认" },
    "lg":         { "$value": "0 16px 40px rgba(24,32,53,0.10)","$type": "shadow", "$description": "Hero / Modal" },
    "blueGlow":   { "$value": "0 12px 28px rgba(95,124,251,0.28)","$type": "shadow", "$description": "主按钮发光" },
    "coralGlow":  { "$value": "0 12px 28px rgba(255,138,122,0.25)","$type": "shadow", "$description": "Offer CTA 发光" }
  },
  "font": {
    "family": {
      "sans": {
        "$value": "'PingFang SC', 'Source Han Sans SC', 'HarmonyOS Sans SC', 'Microsoft YaHei', 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace",
        "$type": "fontFamily",
        "$description": "匹配度数字 / 积分 / 时间戳"
      }
    },
    "size": {
      "hero":        { "$value": "48px", "$type": "dimension", "$description": "首页主标题 44-56px" },
      "page":        { "$value": "36px", "$type": "dimension", "$description": "页面标题 32-40px" },
      "section":     { "$value": "24px", "$type": "dimension", "$description": "模块标题 22-28px" },
      "card":        { "$value": "18px", "$type": "dimension", "$description": "卡片标题 17-20px" },
      "body":        { "$value": "16px", "$type": "dimension" },
      "bodySm":      { "$value": "14px", "$type": "dimension" },
      "caption":     { "$value": "12px", "$type": "dimension" },
      "button":      { "$value": "15px", "$type": "dimension" },
      "dataNumber":  { "$value": "40px", "$type": "dimension", "$description": "匹配度 / 积分 / 大数字 32-48px" }
    },
    "weight": {
      "regular":    { "$value": "400", "$type": "fontWeight" },
      "medium":     { "$value": "500", "$type": "fontWeight" },
      "semibold":   { "$value": "600", "$type": "fontWeight" },
      "bold":       { "$value": "700", "$type": "fontWeight" },
      "extrabold":  { "$value": "800", "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight":   { "$value": "1.15", "$type": "number" },
      "snug":    { "$value": "1.3",  "$type": "number" },
      "normal":  { "$value": "1.5",  "$type": "number" },
      "relaxed": { "$value": "1.7",  "$type": "number" }
    }
  },
  "motion": {
    "duration": {
      "buttonHover":  { "$value": "160ms", "$type": "duration" },
      "cardHover":    { "$value": "200ms", "$type": "duration" },
      "modal":        { "$value": "240ms", "$type": "duration" },
      "progress":     { "$value": "400ms", "$type": "duration", "$description": "匹配度进度条 0→value" },
      "mascot":       { "$value": "400ms", "$type": "duration" }
    },
    "easing": {
      "standard":     { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)",   "$type": "cubicBezier" },
      "spring":       { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" }
    }
  },
  "mascot": {
    "states": [
      "analyzing",
      "interview-prep",
      "resume-edit",
      "offer",
      "thinking",
      "cheering",
      "company-research",
      "networking"
    ],
    "_note": "8 个标准态。职聘跟 UniMate AI 共用牛形象但穿西装戴墨镜+公文包；不允许出现 cert-master 的企鹅。"
  },
  "featureColorMap": {
    "jd-analysis":      { "$value": "{color.brand.primary}",       "$type": "color" },
    "resume-optimize":  { "$value": "{color.functional.success}",  "$type": "color" },
    "interview-prep":   { "$value": "{color.functional.insight}",  "$type": "color" },
    "company-research": { "$value": "{color.brand.navy}",          "$type": "color" },
    "job-tracking":     { "$value": "{color.brand.primary}",       "$type": "color" },
    "offer-success":    { "$value": "{color.brand.accent}",        "$type": "color" },
    "salary-insight":   { "$value": "{color.functional.warning}",  "$type": "color" },
    "missing-skill":    { "$value": "{color.functional.error}",    "$type": "color" },
    "networking":       { "$value": "{color.functional.insight}",  "$type": "color" },
    "ai-message":       { "$value": "{color.brand.primary}",       "$type": "color" }
  }
}
